{
  "unstable": [
    "kv"
  ],
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "require-await"
      ],
      "include": [
        "explicit-function-return-type",
        "no-explicit-any"
      ]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true
  },
  "tasks": {
    "dev": "deno run --unstable-kv --allow-read --allow-write --allow-env --watch main.ts",
    "serve": "deno run --unstable-kv --allow-net --allow-env --allow-read --allow-write http_server.ts",
    "dev:server": "deno run --unstable-kv --allow-net --allow-env --allow-read --allow-write --watch http_server.ts",
    "test": "deno test --unstable-kv --allow-read --allow-write --allow-env --allow-net",
    "test:coverage": "deno test --unstable-kv --allow-read --allow-write --allow-env --allow-net --coverage=cov_profile && deno coverage cov_profile",
    "check": "deno check main.ts http_server.ts && deno lint && deno fmt --check"
  },
  "imports": {
    "@deno/kv-oauth": "jsr:@deno/kv-oauth@^0.11.0",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.29.0",
    "@simplewebauthn/server": "npm:@simplewebauthn/server@^10.0.0",
    "@simplewebauthn/types": "npm:@simplewebauthn/types@^10.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "cytoscape": "npm:cytoscape@^3.30.2",
    "cytoscape-dagre": "npm:cytoscape-dagre@^2.5.0",
    "dagre": "npm:dagre@^0.8.5",
    "zod": "npm:zod@^3.23.0"
  }
}
