{
  "unstable": [
    "kv"
  ],
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "require-await"
      ],
      "include": [
        "explicit-function-return-type",
        "no-explicit-any"
      ]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true
  },
  "tasks": {
    "dev": "deno run --unstable-kv --allow-read --allow-write --watch main.ts",
    "test": "deno test --unstable-kv --allow-read --allow-write",
    "test:coverage": "deno test --unstable-kv --allow-read --allow-write --coverage=cov_profile && deno coverage cov_profile",
    "check": "deno check main.ts && deno lint && deno fmt --check"
  },
  "imports": {
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.29.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "zod": "npm:zod@^3.23.0"
  }
}
